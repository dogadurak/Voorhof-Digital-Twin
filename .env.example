# .env.example — bu dosya repoya girer, .env GIRMEZ (.gitignore).
# Kopyala:  cp .env.example .env   ve gercek degerleri .env icine yaz.
#
# AGENTS.md Bolum 8: "API key / token / credential ASLA repoya yazilmaz."

# KNMI Data Platform — ucretsiz anonim key
# Kayit: https://developer.dataplatform.knmi.nl/
KNMI_API_KEY=

# EP-Online (RVO) — ucretsiz key, enerji etiketi sorgusu (Asama 3)
# Kayit: https://www.ep-online.nl/
EPONLINE_API_KEY=

# Copernicus Data Space — Sentinel-2 NDVI (Asama 4)
CDSE_USERNAME=
CDSE_PASSWORD=

# USGS EarthExplorer — Landsat 8/9 LST (Asama 4)
USGS_USERNAME=
USGS_TOKEN=
