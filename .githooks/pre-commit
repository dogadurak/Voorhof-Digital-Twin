#!/bin/sh
# Surumlenen pre-commit kancasi (M-008 TEKRARI 2, 2026-09-27; AGENTS 14.5 ucuncu tekrar kurali).
# Kurulum (depo basina bir kez):  git config core.hooksPath .githooks
# Kontrollerden biri basarisizsa commit DURUR. Calisma agacini denetler (staged
# degil) — muhafazakar: commit'e girmeyen bir dosyadaki hata da durdurur.
ENV_NAME=voorhof-twin
fail=0
for chk in src/qa/check_refs.py src/qa/check_config_structure.py src/qa/check_claims.py src/qa/check_source_integrity.py; do
    out=$(conda run -n "$ENV_NAME" python "$chk" 2>&1)
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "pre-commit: $chk BASARISIZ (cikis $rc)"
        echo "$out" | tail -15
        fail=1
    else
        echo "pre-commit: $chk PASS"
    fi
done
if [ $fail -ne 0 ]; then
    echo "pre-commit: commit DURDURULDU. Hatayi duzelt; kontrolu atlama (AGENTS 14.5)."
    exit 1
fi
exit 0
